<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MELLSTROY BANK</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:ital,wght@0,400;0,700;0,800;1,400;1,700;1,800&display=swap" rel="stylesheet">
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family: 'Manrope', sans-serif; background: #0f0f0f; color: #fff; line-height: 1.4; overflow-x: hidden; }
  
  .bg-glow { position: fixed; inset: 0; z-index: -2; background: radial-gradient(circle at 50% 50%, #1e1e1e 0%, #0f0f0f 100%); overflow: hidden; }
  .stars-container { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .star { position: absolute; background: #fff; border-radius: 50%; animation: fall linear infinite; }
  @keyframes fall { 0% { transform: translateY(-10vh) translateX(0); opacity: 1; } 100% { transform: translateY(110vh) translateX(50px); opacity: 0; } }

  nav { position: fixed; top: 0; width: 100%; padding: 16px 40px; display: flex; justify-content: space-between; align-items: center; background: rgba(15,15,15,0.8); backdrop-filter: blur(20px); z-index: 100; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .logo { display: flex; align-items: center; gap: 12px; font-size: 1.3rem; font-weight: 800; font-style: italic; }
  .logo-icon { width: 32px; height: 32px; background: #fff; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #000; font-weight: 800; font-size: 1.1rem; }
  .nav-links { display: flex; gap: 24px; }
  .nav-links a { color: #aaa; text-decoration: none; font-size: 0.9rem; font-weight: 600; font-style: italic; transition: color 0.3s; }
  .nav-links a:hover { color: #fff; }
  .btn-outline { padding: 8px 16px; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; color: #fff; text-decoration: none; font-weight: 600; font-style: italic; transition: all 0.3s; }
  .btn-outline:hover { background: rgba(255,255,255,0.1); }

  .tickers-wrap { margin-top: 65px; }
  .ticker-wrap { width: 100%; overflow: hidden; background: rgba(255,255,255,0.03); border-bottom: 1px solid rgba(255,255,255,0.05); padding: 8px 0; }
  .ticker { display: inline-block; white-space: nowrap; animation: ticker 30s linear infinite; }
  .ticker.reverse { animation-direction: reverse; animation-duration: 40s; }
  .ticker.slow { animation-duration: 50s; }
  .ticker span { margin: 0 20px; font-size: 0.8rem; color: #aaa; font-weight: 600; font-style: italic; }
  .ticker span.up { color: #4ade80; }
  .ticker span.down { color: #f87171; }
  @keyframes ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  .hero { min-height: 75vh; display: flex; flex-direction: column; justify-content: center; padding: 40px; position: relative; max-width: 1400px; margin: 0 auto; }
  .hero-sub { font-size: 0.85rem; color: #888; margin-bottom: 16px; font-weight: 700; font-style: italic; text-transform: uppercase; letter-spacing: 1px; }
  .hero h1 { font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 800; font-style: italic; line-height: 1.05; letter-spacing: -1.5px; text-transform: uppercase; z-index: 2; position: relative; }
  .hero h1 span { display: block; }
  .hero h1 span:nth-child(3) { color: #555; }
  .hero p { margin-top: 20px; font-size: 1.05rem; color: #aaa; max-width: 400px; line-height: 1.5; z-index: 2; }

  .sphere-container { position: absolute; top: 50%; right: 5%; width: 400px; height: 400px; z-index: 1; pointer-events: none; will-change: transform; transition: transform 0.1s linear; }
  .sphere { width: 100%; height: 100%; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #fff, #d4d4d4, #a3a3a3, #ffebd4, #d4ebff); box-shadow: inset -15px -15px 50px rgba(0,0,0,0.8), 0 0 60px rgba(255,255,255,0.1); position: relative; overflow: hidden; animation: shakeSphere 3s ease-in-out infinite; }
  .sphere::after { content: ''; position: absolute; inset: 0; background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><path d="M30 50 L50 30 L70 50 L50 70 Z" fill="rgba(255,255,255,0.4)"/></svg>') center/40% no-repeat; filter: blur(4px); animation: rotateShape 20s linear infinite; }
  @keyframes shakeSphere { 0%, 100% { transform: translateY(0) rotate(0deg); } 25% { transform: translateY(-10px) rotate(-2deg); } 50% { transform: translateY(0) rotate(0deg); } 75% { transform: translateY(-5px) rotate(2deg); } }
  @keyframes rotateShape { to { transform: rotate(360deg); } }

  .btn-gradient { display: inline-flex; align-items: center; gap: 12px; padding: 14px 28px; border-radius: 12px; background: linear-gradient(90deg, #a3c2ff, #ffc6e5, #ffe4a3); background-size: 200% 200%; color: #000; font-weight: 800; font-style: italic; font-size: 0.95rem; text-decoration: none; transition: all 0.3s; margin-top: 20px; border: none; cursor: pointer; animation: gradientMove 4s ease infinite; }
  @keyframes gradientMove { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  .btn-gradient:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 10px 30px rgba(255,255,255,0.15); }

  .steps-section { padding: 40px; max-width: 1400px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.05); }
  .steps-section h2 { font-size: 2.5rem; font-weight: 800; font-style: italic; margin-bottom: 30px; text-transform: uppercase; }
  .steps-layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; }
  .step-list { display: flex; flex-direction: column; gap: 20px; }
  .step-item { display: flex; gap: 16px; opacity: 0; transform: translateX(-20px); transition: all 0.6s; }
  .step-item.show { opacity: 1; transform: translateX(0); }
  .step-num { font-size: 0.85rem; color: #666; font-weight: 800; font-style: italic; }
  .step-content h3 { font-size: 1.3rem; font-weight: 800; font-style: italic; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
  .step-content p { color: #888; font-size: 0.95rem; line-height: 1.5; max-width: 280px; }

  .chat-ui { background: #151515; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 16px; opacity: 0; transform: translateY(20px); transition: all 0.8s; }
  .chat-ui.show { opacity: 1; transform: translateY(0); }
  .chat-header { display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 12px; font-size: 0.8rem; color: #888; font-weight: 700; font-style: italic; }
  .chat-body { display: flex; gap: 16px; height: 280px; }
  .chat-sidebar { width: 180px; display: flex; flex-direction: column; gap: 12px; }
  .chat-msg { background: #222; padding: 12px; border-radius: 8px; font-size: 0.8rem; color: #ccc; line-height: 1.4; font-weight: 500; }
  .chat-checklist { display: flex; flex-direction: column; gap: 8px; font-size: 0.75rem; color: #aaa; font-weight: 600; font-style: italic; }
  .chat-checklist span::before { content: '✓'; color: #4ade80; margin-right: 6px; }
  .chat-main { flex: 1; background: #0f0f0f; border-radius: 8px; padding: 16px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; }
  .chat-lines div { height: 6px; background: rgba(255,255,255,0.05); border-radius: 4px; margin-bottom: 10px; animation: pulseOpacity 2s infinite alternate; }
  .chat-lines div:nth-child(1) { width: 40%; } .chat-lines div:nth-child(2) { width: 80%; animation-delay: 0.3s; } .chat-lines div:nth-child(3) { width: 60%; animation-delay: 0.6s; }
  @keyframes pulseOpacity { from { opacity: 0.3; } to { opacity: 0.8; } }
  .chat-preview-box { margin-top: 20px; border: 1px dashed rgba(255,255,255,0.2); padding: 20px; border-radius: 8px; display: flex; justify-content: space-between; align-items: flex-end; }
  .chat-star { font-size: 1.5rem; color: #fff; opacity: 0.5; animation: rotateShape 10s linear infinite; }

  .grid-section { padding: 40px; max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; border-top: 1px solid rgba(255,255,255,0.05); }
  .card-text h2 { font-size: 2.5rem; font-weight: 800; font-style: italic; text-transform: uppercase; margin-bottom: 16px; line-height: 1.1; }
  .card-text p { color: #888; font-size: 0.95rem; line-height: 1.5; max-width: 350px; font-weight: 500; }
  
  .card-visual { perspective: 1000px; display: flex; justify-content: center; margin-top: 20px; }
  .bank-card { width: 100%; max-width: 350px; height: 200px; border-radius: 16px; background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%); border: 1px solid rgba(255,255,255,0.1); position: relative; padding: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.5); transform: rotateY(-15deg) rotateX(10deg); transition: transform 0.5s; animation: floatCard 5s ease-in-out infinite alternate; }
  .bank-card:hover { transform: rotateY(0deg) rotateX(0deg) scale(1.05); }
  @keyframes floatCard { 0% { transform: rotateY(-15deg) rotateX(10deg) translateY(0); } 100% { transform: rotateY(-5deg) rotateX(5deg) translateY(-10px); } }
  .bank-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%); background-size: 200% 100%; animation: shine 3s infinite; border-radius: 16px; }
  @keyframes shine { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
  .card-chip { width: 40px; height: 30px; background: linear-gradient(135deg, #ffd700, #b8860b); border-radius: 4px; margin-bottom: 20px; }
  .card-number { font-family: monospace; font-size: 1.1rem; letter-spacing: 2px; color: #fff; margin-bottom: 16px; font-weight: 700; }
  .card-bottom { display: flex; justify-content: space-between; align-items: flex-end; }
  .card-name { font-size: 0.7rem; text-transform: uppercase; color: #aaa; font-weight: 800; font-style: italic; }
  .card-logo { font-weight: 800; font-size: 1.1rem; color: #fff; font-style: italic; }

  .calc-box { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 24px; }
  .calc-box h2 { font-size: 1.8rem; font-weight: 800; font-style: italic; text-transform: uppercase; margin-bottom: 20px; }
  .calc-group { margin-bottom: 20px; }
  .calc-group label { display: block; font-size: 0.8rem; color: #888; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; font-style: italic; }
  .calc-group input[type="range"] { width: 100%; -webkit-appearance: none; height: 5px; border-radius: 3px; background: #333; outline: none; }
  .calc-group input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: #fff; cursor: pointer; box-shadow: 0 0 10px rgba(255,255,255,0.5); }
  .calc-values { display: flex; justify-content: space-between; font-size: 0.85rem; margin-top: 8px; color: #fff; font-weight: 700; }
  .calc-result { margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
  .calc-result span { font-size: 1.4rem; color: #fff; font-weight: 800; font-style: italic; }
  .calc-result small { color: #888; font-size: 0.8rem; display: block; margin-top: 2px; font-weight: 600; }
  .calc-joke { font-size: 0.8rem; color: #f87171; margin-top: 6px; width: 100%; font-weight: 700; font-style: italic; }

  /* 🎰 Секция Колеса Фортуны */
  .casino-section { padding: 40px; max-width: 1400px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.05); text-align: center; display: flex; flex-direction: column; align-items: center; }
  .casino-section h2 { font-size: 3rem; font-weight: 800; font-style: italic; text-transform: uppercase; margin-bottom: 8px; }
  .casino-sub { font-size: 0.9rem; color: #888; margin-bottom: 30px; font-weight: 600; font-style: italic; }
  .wheel-wrapper { position: relative; width: 300px; height: 300px; margin-bottom: 20px; }
  #wheelCanvas { width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 0 40px rgba(255,255,255,0.1); }
  .wheel-pointer { position: absolute; top: -15px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 15px solid transparent; border-right: 15px solid transparent; border-top: 25px solid #fff; z-index: 2; filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5)); }
  .wheel-btn { margin-top: 10px; background: #fff; color: #000; padding: 12px 30px; border-radius: 50px; font-weight: 800; font-style: italic; font-size: 1rem; border: none; cursor: pointer; transition: transform 0.2s; }
  .wheel-btn:hover { transform: scale(1.05); }
  .wheel-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  .wheel-result { margin-top: 15px; font-size: 1.2rem; font-weight: 800; font-style: italic; height: 24px; }

  .pricing-section { padding: 40px; max-width: 1400px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.05); }
  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 20px; }
  .plan-card { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px; transition: all 0.3s; opacity: 0; transform: translateY(20px); }
  .plan-card.show { opacity: 1; transform: translateY(0); }
  .plan-card:hover { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.2); transform: translateY(-3px); }
  .plan-name { font-size: 0.8rem; color: #888; text-transform: uppercase; margin-bottom: 12px; font-weight: 800; font-style: italic; }
  .plan-price { font-size: 2rem; font-weight: 800; font-style: italic; margin-bottom: 4px; }
  .plan-price span { font-size: 0.9rem; color: #666; font-style: normal; font-weight: 500; }
  .plan-desc { font-size: 0.85rem; color: #888; margin-bottom: 20px; font-weight: 500; }
  .plan-features { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .plan-features li { font-size: 0.85rem; color: #ccc; display: flex; justify-content: space-between; font-weight: 500; }
  .plan-features li span { color: #fff; font-weight: 800; font-style: italic; }

  .cta-section { text-align: center; padding: 60px 40px; border-top: 1px solid rgba(255,255,255,0.05); }
  .cta-section h2 { font-size: 4.5rem; font-weight: 800; font-style: italic; text-transform: uppercase; margin-bottom: 24px; line-height: 1; }
  .cta-section h2 span { color: #555; }

  .mega-footer { padding: 80px 40px; background: #000; border-top: 1px solid rgba(255,255,255,0.1); text-align: center; position: relative; z-index: 10; }
  .mega-footer h2 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; font-style: italic; text-transform: uppercase; margin-bottom: 24px; line-height: 1.1; }
  .mega-footer h2 span { color: #888; }
  .mega-footer p { color: #aaa; font-size: 1.1rem; max-width: 600px; margin: 0 auto 40px; line-height: 1.6; font-weight: 500; }
  .director-signature { display: inline-flex; flex-direction: column; align-items: center; gap: 8px; }
  .director-signature .line { width: 100px; height: 2px; background: #333; margin-bottom: 8px; }
  .director-signature .name { font-size: 1.5rem; font-weight: 800; font-style: italic; color: #fff; }
  .director-signature .title { font-size: 0.9rem; color: #666; text-transform: uppercase; letter-spacing: 2px; font-weight: 700; }

  @media (max-width: 1024px) {
    .steps-layout, .grid-section { grid-template-columns: 1fr; gap: 30px; }
    .sphere-container { opacity: 0.15; right: -10%; }
    .pricing-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    nav { padding: 12px 20px; } .nav-links { display: none; }
    .hero { padding: 80px 20px 20px; } .hero h1 { font-size: 2.8rem; }
    .steps-section, .pricing-section, .grid-section, .casino-section { padding: 30px 20px; }
    .cta-section h2 { font-size: 3rem; }
    .chat-body { flex-direction: column; height: auto; } .chat-sidebar { width: 100%; }
    .mega-footer h2 { font-size: 2rem; }
    .casino-section h2 { font-size: 2rem; }
  }
</style>
</head>
<body>

<div class="bg-glow"></div>
<div class="stars-container" id="stars-container"></div>

<nav>
  <div class="logo"><div class="logo-icon">M</div>MELLSTROY BANK</div>
  <div class="nav-links">
    <a href="#features">Возможности</a>
    <a href="#card">Карта</a>
    <a href="#calc">Калькулятор</a>
    <a href="#casino">Казино</a>
    <a href="#pricing">Тарифы</a>
  </div>
  <div class="nav-right"><a href="#" class="btn-outline">Войти</a></div>
</nav>

<div class="tickers-wrap">
  <div class="ticker-wrap">
    <div class="ticker">
      <span>MELLSTROY INDEX <span class="up">▲ 12.4%</span></span>
      <span>USD / MELLSTROY <span class="up">▲ 0.03</span></span>
      <span>EUR / MELLSTROY <span class="down">▼ 0.01</span></span>
      <span>КРЕДИТ "ПО-БРАТСКИ" <span class="up">▲ 99%</span></span>
      <span>КОКОСОВ В БАНКЕ <span class="up">▲ 5</span></span>
      <span>MELLSTROY INDEX <span class="up">▲ 12.4%</span></span>
      <span>USD / MELLSTROY <span class="up">▲ 0.03</span></span>
      <span>EUR / MELLSTROY <span class="down">▼ 0.01</span></span>
      <span>КРЕДИТ "ПО-БРАТСКИ" <span class="up">▲ 99%</span></span>
      <span>КОКОСОВ В БАНКЕ <span class="up">▲ 5</span></span>
    </div>
  </div>
  <div class="ticker-wrap">
    <div class="ticker reverse">
      <span>ДОВЕРИЕ <span class="down">▼ 0%</span></span>
      <span>ПРОЗРАЧНОСТЬ <span class="up">▲ 100%</span></span>
      <span>ДОЛГИ <span class="up">▲ 200%</span></span>
      <span>НАШИ ПРАВА <span class="up">▲ 100%</span></span>
      <span>ВАШИ ПРАВА <span class="down">▼ 0%</span></span>
      <span>ДОВЕРИЕ <span class="down">▼ 0%</span></span>
      <span>ПРОЗРАЧНОСТЬ <span class="up">▲ 100%</span></span>
      <span>ДОЛГИ <span class="up">▲ 200%</span></span>
      <span>НАШИ ПРАВА <span class="up">▲ 100%</span></span>
      <span>ВАШИ ПРАВА <span class="down">▼ 0%</span></span>
    </div>
  </div>
  <div class="ticker-wrap">
    <div class="ticker slow">
      <span>КОКОСЫ <span class="up">▲ 15%</span></span>
      <span>БАНКА <span class="up">▲ 100%</span></span>
      <span>ДЕНЬГИ <span class="up">▲ 0%</span></span>
      <span>НАШИ ДЕНЬГИ <span class="up">▲ 1000%</span></span>
      <span>КОКОСЫ <span class="up">▲ 15%</span></span>
      <span>БАНКА <span class="up">▲ 100%</span></span>
      <span>ДЕНЬГИ <span class="up">▲ 0%</span></span>
      <span>НАШИ ДЕНЬГИ <span class="up">▲ 1000%</span></span>
    </div>
  </div>
</div>

<header class="hero">
  <div class="hero-sub">Создание кредитов с ИИ по описанию</div>
  <h1>
    <span>НЕ НУЖНО</span>
    <span>ЗНАТЬ КОД.</span>
    <span>НУЖНО ЗНАТЬ,<br>ЧЕГО ХОЧЕТСЯ.</span>
  </h1>
  <p>Опишите кредит своими словами — ИИ соберёт структуру, тексты и оформление. Через 2 минуты у вас черновик, который можно править в чате.</p>
  <div class="sphere-container" id="sphere-container"><div class="sphere"></div></div>
</header>

<section class="steps-section" id="features">
  <h2>ТРИ ШАГА ДО КРЕДИТА.</h2>
  <div class="steps-layout">
    <div class="step-list">
      <div class="step-item">
        <div class="step-num">01</div>
        <div class="step-content"><h3>Расскажите идею</h3><p>Что вы делаете, для кого и в каком стиле. Получите черновик: страницы, тексты и оформление.</p></div>
      </div>
      <div class="step-item">
        <div class="step-num">02</div>
        <div class="step-content"><h3>Поправьте в чате</h3><p>Скажите ИИ, что нужно изменить. Тексты, оформление, структура — всё подстраивается под вас.</p></div>
      </div>
      <div class="step-item">
        <div class="step-num">03</div>
        <div class="step-content"><h3>Опубликуйте</h3><p>Сайт сразу в интернете с хостингом, SSL и вашим доменом.</p></div>
      </div>
      <a href="#" class="btn-gradient">Попробовать со своей идеей <span>↗</span></a>
    </div>
    <div class="chat-ui">
      <div class="chat-header"><span>MELLSTROY / новый кредит</span><span>Предпросмотр ↗</span></div>
      <div class="chat-body">
        <div class="chat-sidebar">
          <div style="font-size: 0.75rem; color: #fff; font-weight: 800; font-style: italic;">✳ ДАВАЙТЕ НАЧНЁМ</div>
          <div class="chat-msg">Кредит небольшой кофейни. Много воздуха, тёплый свет и ощущение паузы.</div>
          <div style="font-size: 0.75rem; color: #fff; margin-top: 12px; font-weight: 800; font-style: italic;">✳ НАЧНЁМ С ПЕРВОГО ВПЕЧАТЛЕНИЯ.</div>
          <div class="chat-checklist"><span>Структура страницы</span><span>Тексты и оформление</span><span>Мобильная версия</span></div>
        </div>
        <div class="chat-main">
          <div class="chat-lines"><div></div><div></div><div></div></div>
          <div class="chat-preview-box"><p style="font-weight: 800; font-style: italic; font-size: 0.8rem;">ВАША ИДЕЯ<br>УЖЕ ОБРЕТАЕТ ФОРМУ.</p><div class="chat-star">✳</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="grid-section" id="card">
  <div class="card-text">
    <h2>КАРТА,<br>КОТОРАЯ<br>ВСЕГДА С ТОБОЙ</h2>
    <p>Виртуальная карта MELLSTROY BANK. Кэшбэк 1% на всё. Остальные 99% мы оставляем себе — за честность.</p>
    <div class="card-visual">
      <div class="bank-card">
        <div class="card-chip"></div>
        <div class="card-number">**** **** **** 1337</div>
        <div class="card-bottom"><div class="card-name">MELLSTROY BANK</div><div class="card-logo">M</div></div>
      </div>
    </div>
  </div>
  
  <div class="calc-box" id="calc">
    <h2>КРЕДИТНЫЙ КАЛЬКУЛЯТОР</h2>
    <div class="calc-group">
      <label>Сумма кредита</label>
      <input type="range" id="amount" min="1000" max="1000000" value="50000" step="1000">
      <div class="calc-values"><span>1 000 ₽</span><span id="amount-val">50 000 ₽</span><span>1 000 000 ₽</span></div>
    </div>
    <div class="calc-group">
      <label>Срок (месяцы)</label>
      <input type="range" id="term" min="1" max="60" value="12" step="1">
      <div class="calc-values"><span>1 мес</span><span id="term-val">12 мес</span><span>60 мес</span></div>
    </div>
    <div class="calc-result">
      <div>
        <small>Ежемесячный платёж</small>
        <span id="payment-val">4 166 ₽</span>
        <div class="calc-joke" id="joke-val">Переплата: 0 ₽ (вы серьёзно?)</div>
      </div>
      <button class="btn-gradient" style="margin-top: 0; padding: 10px 20px; font-size: 0.85rem;">Взять кредит <span>↗</span></button>
    </div>
  </div>
</section>

<!-- 🎰 КОЛЕСО ФОРТУНЫ -->
<section class="casino-section" id="casino">
  <h2>КОЛЕСО ФОРТУНЫ</h2>
  <div class="casino-sub">Чтобы вы не заскучали, пока платите по кредиту</div>
  
  <div class="wheel-wrapper">
    <div class="wheel-pointer"></div>
    <canvas id="wheelCanvas" width="300" height="300"></canvas>
  </div>
  
  <button class="wheel-btn" id="spinBtn">КРУТАНУТЬ 🎰</button>
  <div class="wheel-result" id="wheelResult"></div>
</section>

<section class="pricing-section" id="pricing">
  <div style="font-size: 0.8rem; color: #888; text-transform: uppercase; margin-bottom: 12px; font-weight: 800; font-style: italic;">Сколько это стоит</div>
  <h2 style="font-size: 2.5rem; font-weight: 800; font-style: italic; margin-bottom: 16px;">ОДИН ИНСТРУМЕНТ,<br>РАЗНЫЕ КРЕДИТЫ</h2>
  
  <div class="pricing-grid">
    <div class="plan-card">
      <div class="plan-name">01 / Кредит</div>
      <div class="plan-price">441,67 ₽<span>/мес</span></div>
      <div class="plan-desc">Один кредит: чистая статика</div>
      <ul class="plan-features"><li>Кредитов <span>1</span></li><li>С формами <span>0</span></li><li>Посещений <span>10 000</span></li><li>Место <span>50 MB</span></li></ul>
    </div>
    <div class="plan-card" style="border-color: rgba(255,255,255,0.3);">
      <div class="plan-name" style="color: #fff;">02 / Студия</div>
      <div class="plan-price">630 ₽<span>/мес</span></div>
      <div class="plan-desc">Пять кредитов, один с контейнером</div>
      <ul class="plan-features"><li>Кредитов <span>5</span></li><li>С формами <span>1</span></li><li>Посещений <span>100 000</span></li><li>Место <span>200 MB</span></li></ul>
    </div>
    <div class="plan-card">
      <div class="plan-name">03 / Конструктор</div>
      <div class="plan-price">1 734 ₽<span>/мес</span></div>
      <div class="plan-desc">Соберите тариф под свои задачи</div>
      <ul class="plan-features"><li>Ресурсы <span>∞</span></li><li>Возможности <span>All</span></li><li>Поддержка <span>24/7</span></li></ul>
    </div>
  </div>
</section>

<section class="cta-section">
  <h2>ДАЛЬШЕ <span>БАБКИ.</span></h2>
  <a href="#" class="btn-gradient" style="margin: 0 auto;">Создать свой кредит <span>↗</span></a>
</section>

<section class="mega-footer">
  <h2>МЫ НЕ ПРОСТО БАНК.<br>МЫ <span>МЕЛЬСТРОЙ.</span></h2>
  <p>MELLSTROY BANK — это не просто финансовая организация. Это пиздатый банк, который умеет делать деньги из воздуха, кокосов и ваших нервов. Мы создали империю, где каждый рубль работает на нас. И на вас (иногда).</p>
  <div class="director-signature">
    <div class="line"></div>
    <div class="name">Молчанов</div>
    <div class="title">Директор MELLSTROY BANK</div>
  </div>
</section>

<script>
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      document.querySelector(a.getAttribute('href'))?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('show'), i * 100);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.step-item, .chat-ui, .plan-card').forEach(el => observer.observe(el));

  const amountInput = document.getElementById('amount');
  const termInput = document.getElementById('term');
  const amountVal = document.getElementById('amount-val');
  const termVal = document.getElementById('term-val');
  const paymentVal = document.getElementById('payment-val');
  const jokeVal = document.getElementById('joke-val');

  function updateCalc() {
    const amount = parseInt(amountInput.value);
    const term = parseInt(termInput.value);
    amountVal.textContent = amount.toLocaleString('ru-RU') + ' ₽';
    termVal.textContent = term + ' мес';
    const basePayment = Math.round(amount / term);
    const totalPayment = Math.round(basePayment * 1.1);
    paymentVal.textContent = totalPayment.toLocaleString('ru-RU') + ' ₽';
    const overpayment = (totalPayment * term) - amount;
    if (overpayment > 0) {
      jokeVal.textContent = 'Переплата: ' + overpayment.toLocaleString('ru-RU') + ' ₽ (мы же честные)';
      jokeVal.style.color = '#f87171';
    } else {
      jokeVal.textContent = 'Переплата: 0 ₽ (вы серьёзно?)';
      jokeVal.style.color = '#4ade80';
    }
  }
  amountInput.addEventListener('input', updateCalc);
  termInput.addEventListener('input', updateCalc);
  updateCalc();

  const starsContainer = document.getElementById('stars-container');
  for (let i = 0; i < 50; i++) {
    const star = document.createElement('div');
    star.classList.add('star');
    const size = Math.random() * 2 + 1;
    star.style.width = size + 'px';
    star.style.height = size + 'px';
    star.style.left = Math.random() * 100 + '%';
    star.style.animationDuration = (Math.random() * 5 + 3) + 's';
    star.style.animationDelay = (Math.random() * 5) + 's';
    starsContainer.appendChild(star);
  }

  const sphere = document.getElementById('sphere-container');
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const maxScroll = document.body.scrollHeight - window.innerHeight;
    const progress = scrollY / maxScroll;
    const translateY = progress * 200; 
    const rotate = progress * 360;
    sphere.style.transform = `translateY(${translateY}px) rotate(${rotate}deg)`;
  });

  // 🎰 КОЛЕСО ФОРТУНЫ (JS)
  const canvas = document.getElementById('wheelCanvas');
  const ctx = canvas.getContext('2d');
  const spinBtn = document.getElementById('spinBtn');
  const wheelResult = document.getElementById('wheelResult');
  
  const prizes = [
    "0₽ (Спасибо)", 
    "Кокос 🥥", 
    "+10% к долгу", 
    "Скидка 1%", 
    "Ничего", 
    "Бесплатный звонок", 
    "Кредит на 100 лет", 
    "Золотая карта"
  ];
  const colors = ["#1a1a1a", "#2a2a2a", "#1a1a1a", "#2a2a2a", "#1a1a1a", "#2a2a2a", "#1a1a1a", "#2a2a2a"];
  
  let currentAngle = 0;
  let isSpinning = false;

  function drawWheel() {
    const numPrizes = prizes.length;
    const arcSize = (2 * Math.PI) / numPrizes;
    
    for (let i = 0; i < numPrizes; i++) {
      const angle = currentAngle + i * arcSize;
      ctx.beginPath();
      ctx.fillStyle = colors[i];
      ctx.moveTo(150, 150);
      ctx.arc(150, 150, 150, angle, angle + arcSize);
      ctx.fill();
      
      // Текст
      ctx.save();
      ctx.translate(150, 150);
      ctx.rotate(angle + arcSize / 2);
      ctx.textAlign = "right";
      ctx.fillStyle = "#fff";
      ctx.font = "bold 12px Manrope";
      ctx.fillText(prizes[i], 130, 5);
      ctx.restore();
    }
  }

  function spin() {
    if (isSpinning) return;
    isSpinning = true;
    spinBtn.disabled = true;
    wheelResult.textContent = "Крутим...";
    
    const spinAngle = Math.random() * 2000 + 2000; // Случайный угол
    const duration = 4000; // 4 секунды
    const startAngle = currentAngle;
    const startTime = performance.now();

    function animate(time) {
      const elapsed = time - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      // Плавное замедление (easeOut)
      const easeOut = 1 - Math.pow(1 - progress, 3);
      
      currentAngle = startAngle + spinAngle * easeOut;
      drawWheel();
      
      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        isSpinning = false;
        spinBtn.disabled = false;
        currentAngle = currentAngle % (2 * Math.PI);
        
        // Вычисляем приз (стрелка смотрит вверх, т.е. на -PI/2)
        const numPrizes = prizes.length;
        const arcSize = (2 * Math.PI) / numPrizes;
        let angle = (currentAngle % (2 * Math.PI)) - Math.PI / 2;
        if (angle < 0) angle += 2 * Math.PI;
        
        const prizeIndex = Math.floor(angle / arcSize) % numPrizes;
        wheelResult.textContent = "Вы выиграли: " + prizes[numPrizes - 1 - prizeIndex];
        wheelResult.style.color = "#4ade80";
      }
    }
    requestAnimationFrame(animate);
  }

  drawWheel();
  spinBtn.addEventListener('click', spin);
</script>
</body>
</html>
